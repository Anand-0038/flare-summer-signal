# Coston2 deploy (optional — local mock needs none)
# FLARE_RPC_URL is used by the web API layer (and by scripts when no managed RPC is configured).
# COSTON2_RPC_URL is kept as a compatibility alias for legacy local setups.
FLARE_RPC_URL=
COSTON2_RPC_URL=

# Smart contract tooling variables (deployment only).
FTSO_ADDRESS=
PRIVATE_KEY=
